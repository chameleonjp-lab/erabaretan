{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "trials/p4-03-h2/generated",
    "sourceMap": false
  },
  "include": [
    "packages/**/*.ts",
    "trials/p4-03-h2/**/*.ts"
  ],
  "exclude": [
    "web/**/*.ts",
    "web/generated/**",
    "tests/**/*.ts",
    "tests/**/*.mjs"
  ]
}
