{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "web/generated",
    "sourceMap": false
  },
  "include": ["packages/**/*.ts", "web/src/**/*.ts"],
  "exclude": ["packages/content/src/balance/**/*.ts"]
}
